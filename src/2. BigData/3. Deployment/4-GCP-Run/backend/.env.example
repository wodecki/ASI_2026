# GCP settings for build.sh and deploy.sh - copy to .env and fill in
# Your GCP project ID (see: gcloud projects list)
PROJECT_ID=
REGION=europe-west4
# Artifact Registry repository (create once: gcloud artifacts repositories create iowa --repository-format=docker --location=europe-west4)
REPOSITORY=iowa
IMAGE_TAG=v1
SERVICE_NAME=iowa-backend
