# Copy to .env and fill in

# OpenAI API key - get yours from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI chat model used by both chatbot versions
OPENAI_MODEL=gpt-4o-mini

# GCP settings for build-*.sh, deploy-*.sh and canary.sh
# Your GCP project ID (see: gcloud projects list)
PROJECT_ID=
REGION=europe-west4
# Artifact Registry repository (create once: gcloud artifacts repositories create chatbot --repository-format=docker --location=europe-west4)
REPOSITORY=chatbot
IMAGE_TAG=v1
